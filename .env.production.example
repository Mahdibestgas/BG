# Copy to .env.production ON THE SERVER ONLY and fill in. Never commit the filled-in file.
# Generate each secret on the server:   openssl rand -hex 32
NODE_ENV=production
CF13_DOMAIN=
OWNER_DB_PW=
APP_DB_PW=
SESSION_KEY=
# Public sign-up is closed in production. Set to "on" only for the minutes it takes to create the first owner, then back to "off".
CF13_SIGNUP=off
# Optional: Firebase sign-in (see FIREBASE.md)
FIREBASE_PROJECT_ID=
FIREBASE_WEB_CONFIG=
